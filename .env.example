# Copy these into Vercel (Project Settings > Environment Variables). Never commit real values.
# Optional. Leave unset and create your password on /admin instead.
# Adding, changing or removing it later resets the password made on /admin.
EDIT_PASSWORD=
EDIT_SECRET=a-random-string-of-at-least-32-characters
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional
SITE_URL=https://your-site.example
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
